<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <!-- KLG_PILOT_ENDPOINT -->
  <title>テトラ レプトフィルター 10i | カメライフガイド</title>
  <link rel="stylesheet" href="/css/amazon-product-images.css">
  <style>
    * { box-sizing: border-box; }
    body { margin:0; font: 1rem/1.65 system-ui,sans-serif; background:#f4efe2; color:#182720; }
    header { padding:.8rem 1rem; background:#192e25; color:#fff9e9; font-weight:700; }
    main { width:min(100%,36rem); margin:auto; padding:1.2rem 1rem 2rem; }
    .category { margin:0 0 .35rem; color:#4d6759; font-size:.875rem; font-weight:700; }
    h1 { margin:0 0 .55rem; font-size:clamp(1.45rem,5vw,2rem); line-height:1.3; }
    .sku { margin:0 0 .65rem; color:#4d6759; }
    .gear-card { padding:1rem; border:1px solid #d8d9ca; border-radius:.85rem; background:#fff; }
    .amazon-btn { display:inline-grid; justify-items:center; min-height:44px; max-width:100%; gap:.5rem;
      padding:.65rem .9rem; border-radius:.65rem; background:#294b39; color:#fff; text-decoration:none; font-weight:700; }
    a:focus-visible { outline:3px solid #a26319; outline-offset:4px; }
    .disclosure { margin:0 0 1rem; font-size:.85rem; }
  </style>
  <script src="/js/amazon-product-images.js" defer></script>
</head>
<body>
  <header>カメライフガイド</header>
  <main>
    <article class="gear-card" data-amazon-photo-context>
      <p class="category">カメの飼育用品・フィルター</p>
      <h1>テトラ レプトフィルター 10i</h1>
      <p class="sku">型番：25844</p>
      <p class="disclosure">Amazonの商品リンクには広告を含みます。</p>
      <a class="amazon-btn" data-asin="B000NGQZU0"
        href="https://www.amazon.co.jp/dp/B000NGQZU0?tag=kamelife090e-22"
        data-click-url="https://www.amazon.co.jp/dp/B000NGQZU0?tag=kamelife090e-22"
        rel="sponsored nofollow noopener" target="_blank">Amazonで商品を確認</a>
    </article>
  </main>
</body>
</html>
