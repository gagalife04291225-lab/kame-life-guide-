{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI TikTok Company - 共通メッセージエンベロープ",
  "description": "AI社員間ハンドオフの外側。payload は段階別スキーマに従う。秘密情報を含めない。",
  "type": "object",
  "required": ["msg_id", "epic", "from", "to", "stage", "ts", "status", "payload"],
  "additionalProperties": false,
  "properties": {
    "msg_id": { "type": "string" },
    "epic": { "type": "string", "description": "動画Epicの Issue 参照 (#番号)" },
    "from": { "type": "string", "description": "送信社員ロール" },
    "to": { "type": "string", "description": "受信社員ロール" },
    "stage": { "type": "string", "enum": ["idea", "planning", "script", "qa", "ready", "published"] },
    "ts": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["ok", "reject", "retry"] },
    "payload": { "type": "object" }
  }
}
