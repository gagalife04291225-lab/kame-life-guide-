{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "script -> qa payload (Sprint 1: 言語系のみ。full設計では script->image を経由)",
  "type": "object",
  "required": ["script_ref", "shots", "length_sec", "sources"],
  "additionalProperties": false,
  "properties": {
    "script_ref": { "type": "string", "description": "台本コメントの参照" },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "desc", "sec"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "desc": { "type": "string" },
          "sec": { "type": "number", "minimum": 0 }
        }
      }
    },
    "length_sec": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source", "confidence"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": "string", "enum": ["高", "中", "低"] }
        }
      }
    }
  }
}
