{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ready -> owner payload (Ready Package)",
  "type": "object",
  "required": ["final_ref", "captions", "hashtags", "post_time_suggestion"],
  "additionalProperties": false,
  "properties": {
    "final_ref": { "type": "string" },
    "captions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string" }
    },
    "hashtags": { "type": "array", "items": { "type": "string" } },
    "post_time_suggestion": { "type": "string", "description": "TikTok規約数値は※要検証。推測で断定しない" }
  }
}
