{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan -> script payload",
  "type": "object",
  "required": ["structure", "target", "length_sec", "hook_goal", "prohibitions_checked"],
  "additionalProperties": false,
  "properties": {
    "structure": { "type": "string" },
    "target": { "type": "string" },
    "length_sec": { "type": "integer", "minimum": 1 },
    "hook_goal": { "type": "string" },
    "prohibitions_checked": { "type": "boolean" }
  }
}
